{
  "name": "flight-404",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --import tsx --watch server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/src/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx tests/integration.ts",
    "test:ui": "node scripts/check-journey-ui.mjs",
    "assets:voice": "node scripts/prepare-voice.mjs",
    "predev": "npm run assets:voice",
    "prebuild": "npm run assets:voice"
  },
  "dependencies": {
    "@colyseus/core": "~0.17.52",
    "@colyseus/schema": "^4.0.7",
    "@colyseus/sdk": "~0.17.43",
    "@colyseus/ws-transport": "~0.17.13",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
