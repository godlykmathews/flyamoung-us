# Server process (set these in the shell or hosting provider).
PORT=2567
# Optional comma-separated allowed browser origins for HTTP and WebSocket access.
# CLIENT_ORIGIN=https://your-game.example.com

# Optional client build-time URL for a separately hosted Colyseus server.
# Leave unset for the default local development / same-origin production setup.
# Vite reads client/.env.local; copy this entry there for local client builds.
# VITE_SERVER_URL=wss://flight-404-server.example.com

# Optional integration-test target; server must already be running.
# COLYSEUS_URL=ws://localhost:2567
